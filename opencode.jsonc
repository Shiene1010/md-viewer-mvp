{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3",
  "default_agent": "build",
  "agents": {
    "orchestrator": {
      "description": "스프린트 단위로 워커 서브에이전트를 지휘하는 메인 지휘자",
      "mode": "primary",
      "model": "opencode/muse-spark-1.3#high",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" }
      ]
    },
    "worker": {
      "description": "오케스트레이터 지시로 단일 스토리를 수행하고 짧게 보고하는 워커",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3#medium",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
